{
  "name": "beefbrain",
  "private": true,
  "version": "1.0.0",
  "description": "TTRPG character and creature calculator using human-readable data formats",
  "license": "MIT",
  "author": "DaneWeber",
  "engines": {
    "node": ">=24.10"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm -r --filter '!bnb-web' build",
    "build:all": "pnpm -r build",
    "build:watch": "pnpm -r --filter '!bnb-web' build:watch",
    "clean": "pnpm -r clean",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm --filter bnb-core --filter bnb-cli format:fix",
    "format:check": "pnpm --filter bnb-core --filter bnb-cli format",
    "dev": "pnpm --filter bnb-web dev",
    "doctor:latex": "node scripts/doctor-latex.js"
  },
  "devDependencies": {
    "js-yaml": "^5.4.1"
  },
  "keywords": [
    "typescript",
    "ttrpg",
    "character",
    "creature",
    "dnd",
    "monorepo"
  ]
}
