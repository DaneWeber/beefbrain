// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "Node.js & TypeScript",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/typescript-node:5-24-trixie",
	"features": {
		"ghcr.io/devcontainers-extra/features/pnpm:2": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
		"ghcr.io/helpers4/devcontainer/pnpm-store:1": {}
	},
	"postCreateCommand": "sudo apt-get update && sudo apt-get install -y texlive-latex-base texlive-latex-recommended texlive-fonts-recommended",
	// This image's default container user is actually root (verify with
	// `docker inspect <image> --format '{{.Config.User}}'`). Pin the non-root
	// "node" user (uid 1000) explicitly so files created in the bind-mounted
	// workspace aren't owned by root on the host -- that breaks any tool
	// (pnpm install, etc.) run against the same files outside a container
	// afterwards.
	"remoteUser": "node"

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "yarn install",

	// Configure tool-specific properties.
	// "customizations": {},
}
