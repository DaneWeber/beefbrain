// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "Node.js & TypeScript",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/typescript-node:5-24-trixie",
	"features": {
		"ghcr.io/devcontainers-extra/features/pnpm:2": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/helpers4/devcontainer/pnpm-store:1": {}
	},
	// The claude-code feature installs as root during the image build, leaving
	// /usr/local/share/npm-global/lib/node_modules/@anthropic-ai root-owned while
	// the container runs as "node" -- Claude Code's background self-update then
	// fails with "no_permissions" and silently goes stale. Hand the package dir to
	// node so updates between rebuilds work. Guarded with || true so a future
	// feature that installs elsewhere can't fail container creation.
	"postCreateCommand": "sudo chown -R node:node /home/node/.claude && sudo apt-get update && sudo apt-get install -y texlive-latex-base texlive-latex-recommended texlive-fonts-recommended && (sudo chown -R node:npm /usr/local/share/npm-global/lib/node_modules/@anthropic-ai || true)",
	// This image's default container user is actually root (verify with
	// `docker inspect <image> --format '{{.Config.User}}'`). Pin the non-root
	// "node" user (uid 1000) explicitly so files created in the bind-mounted
	// workspace aren't owned by root on the host -- that breaks any tool
	// (pnpm install, etc.) run against the same files outside a container
	// afterwards.
	"remoteUser": "node",

	// Keep Claude Code's login and initial setup across container rebuilds.
	// CLAUDE_CONFIG_DIR gathers .claude.json (onboarding flags, per-project trust)
	// into the same directory as .credentials.json, and that directory is a named
	// Docker volume, so "Rebuild Container" leaves it untouched. Only the pointer
	// to the volume is committed here -- no credentials.
	"mounts": [
		"source=beefbrain-claude-config,target=/home/node/.claude,type=volume"
	],
	"remoteEnv": {
		"CLAUDE_CONFIG_DIR": "/home/node/.claude"
	}

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "yarn install",

	// Configure tool-specific properties.
	// "customizations": {},
}
