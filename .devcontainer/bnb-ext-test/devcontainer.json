// A second, named devcontainer config (separate from the repo's main
// .devcontainer/devcontainer.json) for testing bnb-ext as a real installed
// extension rather than through the Extension Development Host. Pick
// "bnb-ext (extension test)" when VS Code's Dev Containers extension prompts
// you to choose a configuration ("Dev Containers: Reopen in Container" /
// "Rebuild Container").
//
// For format details, see https://aka.ms/devcontainer.json.
{
  "name": "bnb-ext (extension test)",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:5-24-trixie",
  "features": {
    "ghcr.io/devcontainers-extra/features/pnpm:2": {},
    "ghcr.io/helpers4/devcontainer/pnpm-store:1": {}
  },
  // Builds, packages, and installs bnb-ext as a real VS Code extension.
  // Re-run manually after editing bnb-ext's source to pick up changes
  // without rebuilding the whole container:
  //   bash .devcontainer/bnb-ext-test/install-extension.sh
  "postCreateCommand": "bash .devcontainer/bnb-ext-test/install-extension.sh"
}
