{
  "name": "bnb-ext",
  "displayName": "BeefBrain",
  "description": "Format, calculate, and validate BeefBrain (bnb) TTRPG character YAML files with bnb-core.",
  "version": "0.1.1",
  "private": true,
  "publisher": "daneweber",
  "license": "MIT",
  "author": "DaneWeber",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaneWeber/beefbrain.git",
    "directory": "packages/bnb-ext"
  },
  "categories": [
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "ttrpg",
    "dnd",
    "character-sheet",
    "yaml"
  ],
  "engines": {
    "vscode": "^1.134.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:bnb-yaml",
    "onLanguage:yaml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bnb-yaml",
        "aliases": [
          "BeefBrain YAML"
        ],
        "extensions": [
          ".bnb.yaml",
          ".bnb.yml"
        ]
      }
    ],
    "grammars": [
      {
        "language": "bnb-yaml",
        "scopeName": "source.bnb-yaml",
        "path": "./syntaxes/bnb-yaml.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[bnb-yaml]": {
        "editor.defaultFormatter": "daneweber.bnb-ext"
      }
    },
    "commands": [
      {
        "command": "bnb.formatDocument",
        "title": "BeefBrain: Format and Calculate Character YAML"
      }
    ],
    "configuration": {
      "title": "BeefBrain",
      "properties": {
        "bnb.associateAllYaml": {
          "type": "boolean",
          "default": false,
          "description": "Treat all .yaml/.yml files as BeefBrain character files. When disabled (default), only files ending in .bnb.yaml or .bnb.yml are treated as BeefBrain data."
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm run compile && rimraf dist && node esbuild.mjs",
    "clean": "rimraf dist out",
    "compile": "tsc --noEmit",
    "compile:test": "tsc -p tsconfig.test.json",
    "test": "vitest run src/core",
    "test:e2e": "vscode-test",
    "pretest:e2e": "pnpm run build && pnpm run compile:test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "package": "vsce package --no-dependencies",
    "prepackage": "pnpm run build"
  },
  "dependencies": {
    "bnb-core": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
