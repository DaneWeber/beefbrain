{
  "name": "bnb-cli",
  "version": "1.0.0",
  "description": "Command-line interface for Beef Brain TTRPG character calculator.",
  "main": "./dist/index.js",
  "bin": {
    "bnb": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup-node",
    "clean": "rimraf dist",
    "compile": "tsc",
    "test": "jest --passWithNoTests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write"
  },
  "keywords": [
    "ttrpg",
    "dnd",
    "character-sheet",
    "cli"
  ],
  "author": "DaneWeber",
  "license": "MIT",
  "dependencies": {
    "bnb-core": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.7",
    "ts-jest": "^29.1.4",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
