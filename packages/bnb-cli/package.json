{
  "name": "bnb-cli",
  "version": "1.0.0",
  "description": "Command-line interface for Beef Brain TTRPG character calculator.",
  "main": "./dist/index.mjs",
  "bin": {
    "bnb": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write"
  },
  "keywords": [
    "ttrpg",
    "dnd",
    "character-sheet",
    "cli"
  ],
  "author": "DaneWeber",
  "license": "MIT",
  "dependencies": {
    "bnb-core": "workspace:*",
    "bnb-latex": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
