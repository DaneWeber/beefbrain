{
  "name": "bnb-core",
  "version": "1.0.0",
  "description": "The library that powers the human-readable data formats for TTRPG character and creature calculation.",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "schema/**/*.json"
  ],
  "directories": {
    "lib": "src"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:DaneWeber/beefbrain.git"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "clean": "rimraf dist",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "prepublishOnly": "npm run clean && npm run build",
    "commit": "cz",
    "commitlint": "commitlint --edit",
    "release": "semantic-release"
  },
  "keywords": [
    "typescript",
    "ttrpg",
    "character",
    "creature",
    "library",
    "beef-brain"
  ],
  "author": "DaneWeber",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "mathjs": "^15.2.0",
    "yaml": "^2.9.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
