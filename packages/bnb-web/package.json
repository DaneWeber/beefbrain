{
	"name": "bnb-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"test": "pnpm run test:unit",
		"test:dev": "vitest",
		"test:unit": "vitest run --project server",
		"test:browser": "vitest run --project client",
		"test:vite": "vitest run",
		"test:all": "pnpm run test:vite && pnpm run test:e2e",
		"test:e2e:build": "pnpm --filter bnb-core build && pnpm --filter bnb-latex build",
		"test:e2e": "pnpm run test:browser && playwright test",
		"test:e2e:headed": "pnpm run test:e2e:build && playwright test --headed",
		"test:e2e:debug": "pnpm run test:e2e:build && playwright test --debug",
		"test:e2e:ui": "pnpm run test:e2e:build && playwright test --ui",
		"test:e2e:install": "playwright install --with-deps chromium"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^24.13.3",
		"@vitest/browser-playwright": "^4.1.11",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0"
	},
	"dependencies": {
		"bnb-core": "workspace:*",
		"bnb-latex": "workspace:*",
		"js-yaml": "^5.4.1"
	}
}
